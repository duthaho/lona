# Lona configuration — deploy.sh copies this to .env on first run and fills
# in the secrets it can generate. See README.md for details.

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional: Google AI Studio key (https://aistudio.google.com) — free tier
# with generous daily quota; unlocks Gemini Flash/Pro on both platforms.
# `deploy.sh up` prompts for this if empty (blank to skip).
GOOGLE_API_KEY=

# Optional: GitHub token — unlocks the agent's github skills and lifts the
# Skills Hub 60 req/hr anonymous rate limit. Scope to what you trust the
# agent with (a fine-grained read-only token is a good start).
# `deploy.sh up` prompts for this if empty (blank to skip). For Hermes it is
# also mirrored into data/hermes/.env, where the skills actually read it.
GITHUB_TOKEN=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram user ids allowed to talk to the bot (comma-separated, numeric).
# Hermes: applies everywhere (DMs, groups, topics).
# OpenClaw: injected into the DM allowlist on "up"; first id becomes the
# command owner. Leave empty to use pairing-code approval instead.
TELEGRAM_ALLOWED_USERS=

# Telegram group chat ids the bot may serve (comma-separated).
# OpenClaw: required for any group use — injected into its allowlist on "up".
# Hermes: only needed to let OTHER group members use the bot.
TELEGRAM_GROUP_ALLOWED_CHATS=

# Hermes only: extra user ids allowed in groups.
TELEGRAM_GROUP_ALLOWED_USERS=

# Cron schedule for scheduled chain-health checks (installed with
# "./deploy.sh <platform> doctor install"). Default: every 6 hours.
# DOCTOR_CRON_SCHEDULE=0 */6 * * *

# Cron schedule for scheduled transactional updates (installed with
# "./deploy.sh <platform> update install"). Default: daily at 04:00.
# UPDATE_CRON_SCHEDULE=0 4 * * *

# Seconds to wait for the freshly pulled container to become healthy before
# the update rolls back to the previous image. Default: 120.
# UPDATE_CANARY_WAIT=120

# Docker bridge MTU (default 1200). Lower it if the host has a reduced path
# MTU to Telegram (jumbo-frame NIC or tunnelled egress) causing polling to
# hang on timeouts/"Bad Gateway"; raise toward 1500 on a normal network.
# DOCKER_MTU=1200

# ---- OpenClaw ----
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
# Control UI auth token — generated by deploy.sh
OPENCLAW_GATEWAY_TOKEN=
# Keep bound to loopback; access via SSH tunnel (see README)
OPENCLAW_BIND=127.0.0.1
OPENCLAW_PORT=18789

# ---- Hermes Agent ----
HERMES_IMAGE=nousresearch/hermes-agent:latest
HERMES_UID=1000
HERMES_GID=1000
# Keep bound to loopback; access via SSH tunnel (see README)
HERMES_DASHBOARD_BIND=127.0.0.1
HERMES_DASHBOARD_USER=admin
# Generated by deploy.sh
HERMES_DASHBOARD_PASSWORD=
# Internal Hermes Runs API used by Cohub. Never publish port 8642 to the host.
HERMES_API_SERVER_KEY=
# Optional dedicated Hermes API profile for Cohub workflow generation. It must expose zero enabled toolsets; Cohub verifies this and fails closed.
HERMES_DESIGNER_API_BASE=
# Optional key for the dedicated designer endpoint; defaults to HERMES_API_SERVER_KEY when blank.
HERMES_DESIGNER_API_KEY=

# ---- Cohub personal coworker ----
# Keep bound to loopback; access remotely through SSH, Tailscale, or Cloudflare Access.
COHUB_BIND=127.0.0.1
COHUB_PORT=8765
# Dashboard/API bearer token — generated by deploy.sh.
COHUB_API_TOKEN=

# ---- Multica AI Agent Platform ----
# Self-hosted agent team platform: https://github.com/multica-ai/multica
# Enable with: ./deploy.sh multica up
#
# Required secrets — generated by deploy.sh on first run.
MULTICA_JWT_SECRET=
MULTICA_POSTGRES_PASSWORD=
# Encrypt at-rest VCS tokens (Forgejo/Gitea/GitLab). Generate: openssl rand -base64 32
MULTICA_VCS_SECRET_KEY=

# LLM backend for internal helpers (chat title generation, follow-up suggestions).
# Defaults to OpenRouter using OPENROUTER_API_KEY. Override only if needed.
# MULTICA_LLM_BASE_URL=https://openrouter.ai/api/v1
# MULTICA_LLM_DEFAULT_MODEL=anthropic/claude-haiku-5.5

# Ports — keep bound to loopback; expose via SSH tunnel or reverse proxy.
MULTICA_BACKEND_BIND=127.0.0.1
MULTICA_BACKEND_PORT=8083
MULTICA_FRONTEND_BIND=127.0.0.1
MULTICA_FRONTEND_PORT=3000

# Public URL of the Multica frontend — used for GitHub App OAuth redirects,
# invitation email links, and CORS. Must match the domain you expose externally.
FRONTEND_ORIGIN=

# Production/development mode. Use "production" for public deployments.
# "development" enables a fixed login code via MULTICA_DEV_VERIFICATION_CODE.
MULTICA_APP_ENV=production

# Signup control. Set false after seeding your admin account.
# MULTICA_ALLOWED_EMAILS restricts signups to a comma-separated list of addresses.
MULTICA_ALLOW_SIGNUP=false
# MULTICA_ALLOWED_EMAILS=

# Email delivery — choose one: Resend API (recommended) or SMTP relay.
# Without either, verification codes print to stdout (dev only).
# Resend: create API key at resend.com, verify your sender domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# SMTP alternative:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_TLS=starttls   # or: implicit / smtps / ssl (for port 465)
# SMTP_TLS_INSECURE=false

# GitHub App — required for PR mirroring and CI status enrichment.
# Create at github.com/settings/apps → New GitHub App, then fill these in.
# Setup URL:   https://<your-domain>/api/github/setup
# Webhook URL: https://<your-domain>/api/webhooks/github
# Permissions: Pull requests (R/W), Checks (R), Contents (R), Metadata (R)
# Events:      pull_request, check_suite, check_run, commit statuses
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=   # PEM block — double-quote in .env so newlines survive
GITHUB_WEBHOOK_SECRET=

# Telegram integration for Multica (separate from Hermes/OpenClaw bot tokens).
# MULTICA_TELEGRAM_SECRET_KEY=   # encrypt per-installation bot tokens at rest

# Image tags — pin to a specific release for reproducible deploys.
# MULTICA_IMAGE_TAG=latest
