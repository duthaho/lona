# Lona configuration — deploy.sh copies this to .env on first run and fills
# in the secrets it can generate. See README.md for details.

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Optional: Google AI Studio key (https://aistudio.google.com) — free tier
# with generous daily quota; unlocks Gemini Flash/Pro on both platforms.
# `deploy.sh up` prompts for this if empty (blank to skip).
GOOGLE_API_KEY=

# Optional: GitHub token — unlocks the agent's github skills and lifts the
# Skills Hub 60 req/hr anonymous rate limit. Scope to what you trust the
# agent with (a fine-grained read-only token is a good start).
# `deploy.sh up` prompts for this if empty (blank to skip). For Hermes it is
# also mirrored into data/hermes/.env, where the skills actually read it.
GITHUB_TOKEN=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram user ids allowed to talk to the bot (comma-separated, numeric).
# Hermes: applies everywhere (DMs, groups, topics).
# OpenClaw: injected into the DM allowlist on "up"; first id becomes the
# command owner. Leave empty to use pairing-code approval instead.
TELEGRAM_ALLOWED_USERS=

# Telegram group chat ids the bot may serve (comma-separated).
# OpenClaw: required for any group use — injected into its allowlist on "up".
# Hermes: only needed to let OTHER group members use the bot.
TELEGRAM_GROUP_ALLOWED_CHATS=

# Hermes only: extra user ids allowed in groups.
TELEGRAM_GROUP_ALLOWED_USERS=

# Cron schedule for scheduled chain-health checks (installed with
# "./deploy.sh <platform> doctor install"). Default: every 6 hours.
# DOCTOR_CRON_SCHEDULE=0 */6 * * *

# Cron schedule for scheduled transactional updates (installed with
# "./deploy.sh <platform> update install"). Default: daily at 04:00.
# UPDATE_CRON_SCHEDULE=0 4 * * *

# Seconds to wait for the freshly pulled container to become healthy before
# the update rolls back to the previous image. Default: 120.
# UPDATE_CANARY_WAIT=120

# Docker bridge MTU (default 1200). Lower it if the host has a reduced path
# MTU to Telegram (jumbo-frame NIC or tunnelled egress) causing polling to
# hang on timeouts/"Bad Gateway"; raise toward 1500 on a normal network.
# DOCKER_MTU=1200

# ---- OpenClaw ----
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
# Control UI auth token — generated by deploy.sh
OPENCLAW_GATEWAY_TOKEN=
# Keep bound to loopback; access via SSH tunnel (see README)
OPENCLAW_BIND=127.0.0.1
OPENCLAW_PORT=18789

# ---- Hermes Agent ----
HERMES_IMAGE=nousresearch/hermes-agent:latest
HERMES_UID=1000
HERMES_GID=1000
# Keep bound to loopback; access via SSH tunnel (see README)
HERMES_DASHBOARD_BIND=127.0.0.1
HERMES_DASHBOARD_USER=admin
# Generated by deploy.sh
HERMES_DASHBOARD_PASSWORD=
# Internal Hermes Runs API used by Cohub. Never publish port 8642 to the host.
HERMES_API_SERVER_KEY=

# ---- Cohub personal coworker ----
# Keep bound to loopback; access remotely through SSH, Tailscale, or Cloudflare Access.
COHUB_BIND=127.0.0.1
COHUB_PORT=8765
# Dashboard/API bearer token — generated by deploy.sh.
COHUB_API_TOKEN=
