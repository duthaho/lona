// OpenClaw gateway config (JSON5) — seeded to data/openclaw/openclaw.json on
// first deploy. Edit that copy (hot-reloads) or run: ./deploy.sh openclaw config
{
  gateway: {
    mode: "local",
    port: 18789,
    auth: { token: "${OPENCLAW_GATEWAY_TOKEN}" },
    reload: { mode: "hybrid" },
  },

  session: {
    dmScope: "per-channel-peer",   // isolated session per DM sender; "main" = one shared session
  },

  agents: {
    defaults: {
      // Free chain ($0). Have OpenRouter credit? Add a cheap paid model as the
      // last fallback to survive the free daily cap: "openrouter/openai/gpt-oss-120b".
      // Subscription alt: primary "google/gemini-3.6-flash" | "anthropic/claude-opus-5" (docs/subscriptions.md).
      model: {
        primary: "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
        fallbacks: [
          "openrouter/z-ai/glm-5.2:free",
          "openrouter/nvidia/nemotron-3-super-120b-a12b:free",
          "openrouter/google/gemma-4-31b-it:free",
        ],
      },
      imageMaxDimensionPx: 800,   // downscale images (default 1200) to save vision tokens
      // Restrict skills with an allowlist (replaces default, not merges): skills: ["github", "notion"],
    },
    entries: {
      main: {
        default: true,
        // groupChat: { mentionPatterns: ["@my_bot"] },   // set to your bot @handle for groups
      },
    },
  },

  // Free models are easier to prompt-inject — keep the blast radius small.
  tools: {
    fs: { workspaceOnly: true },
    elevated: { enabled: false },
  },

  // Skills are all-on by default (agents.defaults.skills omitted).
  // Workshop = self-improving skills; on free models hold captures for manual
  // approval (review: `openclaw skills`). Set approvalPolicy "auto" on frontier models.
  skills: {
    load: { watch: true },
    workshop: {
      autonomous: { mode: "auto" },
      approvalPolicy: "manual",
      maxPending: 50,
      maxSkillBytes: 40000,
    },
  },

  // Plugins/MCP enabled; nothing installed yet (add via `./deploy.sh openclaw cli plugins add …`).
  // Harden with allow/deny lists on group-exposed bots.
  plugins: {
    enabled: true,
  },

  commands: {
    ownerAllowFrom: [
      // __LONA_OWNER__ (do not remove this marker)
    ],
  },

  channels: {
    telegram: {
      // Token from TELEGRAM_BOT_TOKEN. With TELEGRAM_ALLOWED_USERS set, deploy.sh
      // fills allowFrom and switches dmPolicy to "allowlist"; else DMs use pairing:
      //   ./deploy.sh openclaw cli pairing approve telegram <CODE>
      enabled: true,
      streaming: { mode: "partial" },   // progressive reply edits (off | partial | block | progress)
      dmPolicy: "pairing",
      allowFrom: [
        // Populated by deploy.sh from TELEGRAM_ALLOWED_USERS in .env.
        // __LONA_ALLOWFROM__ (do not remove this marker)
      ],
      groupPolicy: "allowlist",
      groups: {
        // Populated by deploy.sh from TELEGRAM_GROUP_ALLOWED_CHATS in .env.
        // __LONA_GROUPS__ (do not remove this marker)
      },
    },
  },
}
